{
  "name": "kairos",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "pnpm --dir backend run dev",
    "dev:frontend": "pnpm --dir frontend run dev",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm --filter @kairos/frontend typecheck && pnpm --filter @kairos/backend build",
    "test": "pnpm --filter @kairos/backend test",
    "test:e2e": "playwright test",
    "start": "pnpm --filter @kairos/backend start",
    "format": "pnpm --filter @kairos/backend format",
    "lint": "pnpm -r --if-present run lint",
    "check": "pnpm --filter @kairos/backend check",
    "clean": "pnpm --filter @kairos/backend clean"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.1.0"
  }
}
